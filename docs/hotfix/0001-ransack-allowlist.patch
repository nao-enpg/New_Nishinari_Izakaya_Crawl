---
 app/models/application_record.rb | 6 ++++--
 app/models/izakaya.rb            | 9 +++++++++
 app/models/tag.rb                | 5 +++++
 3 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/app/models/application_record.rb b/app/models/application_record.rb
index 0a1bc32..73c89fb 100644
--- a/app/models/application_record.rb
+++ b/app/models/application_record.rb
@@ -1,11 +1,13 @@
 class ApplicationRecord < ActiveRecord::Base
   primary_abstract_class
 
+  # ransack で検索・並べ替えに使ってよい列と関連は、各モデルで明示的に許可する。
+  # 既定は何も許可しない（以前は全列・全関連を許可しており、メールアドレスなどを検索条件にできた）。
   def self.ransackable_attributes(_auth_object = nil)
-    authorizable_ransackable_attributes
+    []
   end
 
   def self.ransackable_associations(_auth_object = nil)
-    authorizable_ransackable_associations
+    []
   end
 end
diff --git a/app/models/izakaya.rb b/app/models/izakaya.rb
index ccc1cda..17960c6 100644
--- a/app/models/izakaya.rb
+++ b/app/models/izakaya.rb
@@ -4,4 +4,13 @@ class Izakaya < ApplicationRecord
   has_many :izakaya_plans
   has_many :plans, through: :izakaya_plans
   has_many :favorites, dependent: :destroy
+
+  # 居酒屋一覧の検索で使う条件だけを許可する（q[name_cont]、q[tags_id_all][]）
+  def self.ransackable_attributes(_auth_object = nil)
+    %w[name]
+  end
+
+  def self.ransackable_associations(_auth_object = nil)
+    %w[tags]
+  end
 end
diff --git a/app/models/tag.rb b/app/models/tag.rb
index 7d8fff1..2fb0781 100644
--- a/app/models/tag.rb
+++ b/app/models/tag.rb
@@ -1,4 +1,9 @@
 class Tag < ApplicationRecord
   has_many :izakaya_tags
   has_many :izakayas, through: :izakaya_tags
+
+  # q[tags_id_all][] のために id だけを許可する
+  def self.ransackable_attributes(_auth_object = nil)
+    %w[id]
+  end
 end
