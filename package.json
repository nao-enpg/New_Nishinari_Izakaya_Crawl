{
  "name": "nishinari-next",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "prisma:generate": "prisma generate",
    "typecheck:i18n": "tsc -p tsconfig.i18ncheck.json"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/client": "7.10.1",
    "firebase": "13.2.0",
    "isbot": "5.2.3",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "workerd"
    ]
  }
}
